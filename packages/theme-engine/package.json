{
  "name": "@nicksaulnier/design-system-theme-engine",
  "version": "0.0.1",
  "description": "Claude-powered theme generation: brand description -> validated design tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@nicksaulnier/design-system-tokens": "workspace:*",
    "culori": "^4.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/culori": "^2.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
