{
  "name": "@nicksaulnier/design-system-tokens",
  "version": "0.0.0",
  "description": "Design token schema, Zod validators, and CSS variable emitter for the AI-powered design system.",
  "keywords": [
    "design-system",
    "design-tokens",
    "css-variables",
    "zod",
    "theme",
    "color-scale",
    "lch",
    "w3c-design-tokens",
    "tailwind",
    "figma-tokens"
  ],
  "license": "MIT",
  "author": "Nick Saulnier",
  "homepage": "https://github.com/NickSaulnier/DesignSystem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickSaulnier/DesignSystem.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/NickSaulnier/DesignSystem/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
